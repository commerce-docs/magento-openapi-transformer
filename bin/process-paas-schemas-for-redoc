#!/bin/bash
set -e

source bin/functions.sh

echo 'Checking if all required files exist...'
artifacts_dir="${ARTIFACTS_DIR:-__output__/artifacts}"
files=(
  "${artifacts_dir}/admin-schema-original.json"
  "${artifacts_dir}/customer-schema-original.json"
  "${artifacts_dir}/guest-schema-original.json"
)

for file in "${files[@]}"; do
  if [ ! -f "$file" ]; then
    echo "ERROR: File $file does not exist. Exiting."
    exit 1
  fi
done

echo 'Checking if the required dependencies are installed...'
check_dependencies

echo 'Processing the schemas...'
transform_paas
edit_paas
convert_paas
compare_yaml_schemas
